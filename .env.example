ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

OPENSYMBOLS_SECRET=
OPENSYMBOLS_LOCALE=en

DATABASE_FILE=aac.db

# Elasticsearch pictogram search.
#
# SYMBOL_SEARCH picks the retrieval backend and defaults to legacy, so a checkout
# with no Elastic credentials behaves exactly as it did before. Set it to elastic
# only once scripts/index-symbols.mjs has actually built the index; the app falls
# back to the live ARASAAC and OpenSymbols path on any Elastic error either way.
SYMBOL_SEARCH=legacy

# From your Elastic Cloud deployment. Never commit the real values.
ELASTIC_NODE=
ELASTIC_API_KEY=
ELASTIC_SYMBOL_INDEX=talkalotta-symbols

# serverless for Elastic Cloud Serverless, stack for local Docker or a classic
# self-hosted deployment.
ELASTIC_SERVER_MODE=serverless

# Multimodal. The leading dot marks a preconfigured Elastic inference endpoint,
# so this needs no separate Jina API key. Leave ELASTIC_MULTIMODAL false until
# `npm run symbols:images` has finished: hybrid search against an index with no
# embeddings in it is worse than lexical search alone.
ELASTIC_INFERENCE_ID=.jina-embeddings-v5-omni-small
ELASTIC_MULTIMODAL=false

# Retrieval tuning. ELASTIC_TIMEOUT_MS is how long a board open will wait before
# giving up and using the live libraries instead. ELASTIC_SCORE_K is the BM25
# score a merely-decent match lands on, used to turn _score into a 0-1
# confidence; raise it if reported confidence looks too generous.
ELASTIC_TIMEOUT_MS=4000
ELASTIC_SCORE_K=14
